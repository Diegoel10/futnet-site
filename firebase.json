{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "node_modules/**",
      "functions/**",
      "package.json",
      "package-lock.json",
      "CNAME",
      "**/*.md",
      "**/*.p8",
      "**/*.log",
      "storage.rules"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}